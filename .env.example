# ==============================================================================
# FC TNT - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# Sao chép file này thành .env: cp .env.example .env
# ==============================================================================

# 1. Cấu hình máy chủ (Server Settings)
PORT=3000
NODE_ENV=development

# 2. Cơ sở dữ liệu (Database Connection)
# Chạy MongoDB cục bộ (Local):
MONGODB_URI=mongodb://localhost:27017/fc_ntn
# Hoặc MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fc_ntn?retryWrites=true&w=majority

# 3. Bảo mật & Xác thực (Security & Authentication)
# Mã PIN Quản trị viên (Khuyến nghị: Đặt chuỗi bí mật tối thiểu 6 ký tự)
ADMIN_PIN=your_custom_admin_pin_here

# Mã PIN Thủ quỹ quản lý quỹ đội bóng (Tùy chọn)
TREASURER_PIN=your_custom_treasurer_pin_here

# Chuỗi bí mật ký xác thực Token phiên (Tùy chọn, hệ thống tự sinh ngẫu nhiên khi khởi động nếu để trống)
JWT_SECRET=your_super_secret_jwt_key_here

# Danh sách domain được phép gọi API (CORS Whitelist cho Production, phân tách bằng dấu phẩy)
# ALLOWED_ORIGINS=https://fc-tnt.onrender.com,https://yourdomain.com

# 4. Trí tuệ nhân tạo (Google Gemini AI)
# Dùng cho tính năng: AI chấm điểm trận đấu phong cách Sofascore & Cố vấn thời tiết sân cỏ
# Đăng ký lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Tự động hóa tài chính (VietQR Casso Webhook) [Tùy chọn]
# Token bảo mật xác thực request webhook từ Casso.vn
CASSO_WEBHOOK_TOKEN=your_casso_webhook_token_here

# 6. Lưu trữ ảnh trực tuyến (Cloudinary) [Tùy chọn]
# Cấu hình lưu trữ ảnh khoảnh khắc và avatar cầu thủ lên Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
